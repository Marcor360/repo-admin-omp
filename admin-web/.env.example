VITE_FIREBASE_API_KEY=tu_api_key
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto
VITE_FIREBASE_STORAGE_BUCKET=tu-proyecto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxxxxxxxx

# Servidor
PORT=3000

# Correos autorizados a entrar al panel (separados por comas, sin espacios).
# Sin esta variable el servidor rechaza TODAS las solicitudes (falla cerrado).
OWNER_EMAILS=propietario@example.com

# Origen exacto del frontend cuando corre en un dominio distinto al de la API.
# En Cloud Run, con el mismo servicio sirviendo frontend y backend, se puede
# dejar vacío (same-origin no necesita CORS).
ALLOWED_ORIGIN=

# Firebase Admin SDK (solo backend; nunca uses el prefijo VITE_ para secretos)
FIREBASE_SERVICE_ACCOUNT_TYPE=service_account
FIREBASE_PROJECT_ID=tu-proyecto
FIREBASE_PRIVATE_KEY_ID=tu_private_key_id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nTU_CLAVE_PRIVADA\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@tu-proyecto.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=000000000000000000000
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
FIREBASE_CLIENT_X509_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk%40tu-proyecto.iam.gserviceaccount.com
FIREBASE_UNIVERSE_DOMAIN=googleapis.com
