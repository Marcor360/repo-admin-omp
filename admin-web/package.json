{
  "name": "omp-admin-portal",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev:frontend": "vite",
    "dev:backend": "tsx watch src/server/index.ts",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production tsx src/server/index.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "validate": "npm run typecheck && npm run lint && npm run test",
    "grant:owner": "tsx scripts/grant-owner.ts",
    "migrate:plan-keys": "tsx scripts/migrate-plan-keys.ts",
    "migrate:lifecycle-status": "tsx scripts/migrate-lifecycle-status.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "firebase": "^12.12.1",
    "firebase-admin": "^14.2.0",
    "react": "^19.1.2",
    "react-dom": "^19.1.2",
    "react-router": "^8.3.0",
    "stripe": "^22.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^9.2.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.8.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "uuid": "11.1.1"
  }
}
